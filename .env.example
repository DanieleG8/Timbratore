# Variabili d'ambiente. Su Railway vanno in Variables, MAI nel repository.

# Database: Railway la imposta da sola collegando il servizio PostgreSQL
# (es. ${{Postgres.DATABASE_URL}}). In locale, se manca, si usa un database
# su file in .dati-locali/.
DATABASE_URL=

# Chiave per firmare le sessioni: una stringa casuale lunga.
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Indirizzo pubblico dell'app (link di attivazione password, ritorno del login).
PUBLIC_BASE_URL=https://presenze.esempio.it

# Login Microsoft: stesso tenant di orderEntry, registrazione app dedicata
# di tipo "Single-page application" con redirect URI = PUBLIC_BASE_URL + "/".
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Login Google Workspace: client OAuth di tipo "Web", origine JavaScript
# autorizzata = PUBLIC_BASE_URL. Schermata di consenso "Interna".
GOOGLE_CLIENT_ID=
GOOGLE_HD=dominio-aziendale.it

# Primo avvio: se non c'è ancora un amministratore lo crea con questa email.
# Può entrare con Microsoft/Google (stessa email) o con ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ogni quanti minuti gira la chiusura automatica delle giornate aperte (predefinito 5).
CHIUSURA_INTERVALLO_MIN=5
